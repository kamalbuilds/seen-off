{
  "name": "outbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Outbox: carrier-pickup proof for people who ship from home, built on the Ring Partner API.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "test:whep": ".venv-rtc/bin/python worker/test_whep_loopback.py",
    "mutation": "scripts/mutation-check.sh",
    "spike:porch": "node spikes/porch/run.ts main",
    "metric": "node metric/run.ts",
    "serve": "node src/main.ts",
    "serve:replay": "node scripts/replay-serve.ts",
    "ring:probe": "node scripts/ring-probe.ts",
    "ring:preflight": "node scripts/ring-preflight.ts",
    "ring:setup": "node scripts/ring-setup.ts",
    "railway:deploy": "scripts/railway-deploy.sh"
  }
}
