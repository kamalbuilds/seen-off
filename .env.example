# Names only. Put real values in .env (gitignored), never in chat or commits.
VISION_PROVIDER=                    # unset = bedrock-mantle when AWS_BEARER_TOKEN_BEDROCK is set; or bedrock, openrouter
BEDROCK_MANTLE_MODEL=qwen.qwen3-vl-235b-a22b-instruct
OPENROUTER_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
RING_PLAYGROUND_TOKEN=              # 30 minute Playground token, or the three below for a registered app
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REFRESH_TOKEN=
RING_WEBHOOK_SIGNING_KEY=           # the HMAC signing key shown once when the app is created
SHIPPO_API_KEY=                     # shippo_test_... for test mode
WHEP_PYTHON=.venv-rtc/bin/python
