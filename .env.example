# Names only. Put real values in .env (gitignored), never in chat or commits.
VISION_PROVIDER=                    # unset = bedrock-mantle when AWS_BEARER_TOKEN_BEDROCK is set; or bedrock, openrouter
BEDROCK_MANTLE_MODEL=qwen.qwen3-vl-235b-a22b-instruct
OPENROUTER_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
RING_PLAYGROUND_TOKEN=              # 30 minute Playground token, or the three below for a registered app
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REFRESH_TOKEN=
RING_WEBHOOK_SIGNING_KEY=           # the HMAC signing key shown once when the app is created
SHIPPO_API_KEY=                     # shippo_test_... for test mode
WHEP_PYTHON=.venv-rtc/bin/python
ALERT_WEBHOOK_URL=                  # a Slack, Discord-compatible or ntfy incoming webhook that receives every alert as a phone notification
RING_REDIRECT_URI=                  # the redirect URI registered for this app in the Ring Developer Portal (default http://localhost:PORT/ring/callback)
RING_TOKEN_KEY=                     # optional: 32-byte key (64 hex chars) that seals the saved Ring token; generated into data/ when empty
OUTBOX_PUBLIC_URL=                  # this server's public https address; Connect Ring shows the Ring console URLs built from it
OUTBOX_SIGN_IN_CODE=                # the code you type at the sign-in page Ring sends you to when you link your account
RING_LINK_METHOD=                   # ring-driven (default, any registered app) or partner-initiated (allowlisted apps)
